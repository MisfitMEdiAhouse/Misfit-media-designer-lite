{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/proof", "destination": "/portfolio", "permanent": true },
    { "source": "/snapsite", "destination": "/quotelink", "permanent": true },
    { "source": "/roads", "destination": "/rig-radar", "permanent": true },
    { "source": "/roads-garage", "destination": "/rig-radar", "permanent": true },
    { "source": "/coffee-admin", "destination": "/coffee/admin", "permanent": false },
    { "source": "/tyler", "destination": "/tyler-ward", "permanent": true },
    { "source": "/caj-live", "destination": "https://www.coffeeandajoint.co/", "permanent": true },
    { "source": "/caj-live.html", "destination": "https://www.coffeeandajoint.co/", "permanent": true },
    { "source": "/coffeeandjoint", "destination": "https://www.coffeeandajoint.co/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/scrub", "destination": "/" },
    { "source": "/agency", "destination": "/" },
    { "source": "/products", "destination": "/" },
    { "source": "/explore", "destination": "/" },
    { "source": "/operator", "destination": "/" },
    { "source": "/field-notes", "destination": "/" },
    { "source": "/field-notes/:slug", "destination": "/" },
    { "source": "/portfolio", "destination": "/" },
    { "source": "/portfolio/ials-turbine-command", "destination": "/" },
    { "source": "/portfolio/golden-essence", "destination": "/" },
    { "source": "/portfolio/golden-essence/about", "destination": "/" },
    { "source": "/portfolio/golden-essence/services", "destination": "/" },
    { "source": "/portfolio/golden-essence/policies", "destination": "/" },
    { "source": "/portfolio/golden-essence/contact", "destination": "/" },
    { "source": "/portfolio/golden-essence-mobile", "destination": "/" },
    { "source": "/agents", "destination": "/" },
    { "source": "/command", "destination": "/" },
    { "source": "/command-reset", "destination": "/" },
    { "source": "/heir", "destination": "/" },
    { "source": "/shopify-ai-audit", "destination": "/" },
    { "source": "/a2a-agent-audit", "destination": "/" },
    { "source": "/agent-evaluation-lab", "destination": "/" },
    { "source": "/signal", "destination": "/" },
    { "source": "/worldforge", "destination": "/" },
    { "source": "/enterprise-ai", "destination": "/" },
    { "source": "/creator-commerce", "destination": "/" },
    { "source": "/misfit-ai-v2", "destination": "/" },
    { "source": "/rig-radar", "destination": "/" },
    { "source": "/roads/admin", "destination": "/" },
    { "source": "/coffee/admin", "destination": "/" },
    { "source": "/tyler-ward", "destination": "/" },
    { "source": "/quotelink", "destination": "/" }
  ],
  "headers": [
    { "source": "/.well-known/ucp", "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }] },
    { "source": "/command", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }] },
    { "source": "/command-reset", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }, { "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/heir", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }] },
    { "source": "/roads/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }] },
    { "source": "/coffee/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }, { "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/coffee-restored", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }, { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }] }
  ]
}
