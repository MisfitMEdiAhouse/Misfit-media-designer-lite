{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/command", "destination": "https://misfit-cloud.vercel.app/login", "permanent": false },
    { "source": "/snapsite", "destination": "/quotelink", "permanent": true }
  ],
  "rewrites": [
    { "source": "/agents", "destination": "/" },
    { "source": "/shopify-ai-audit", "destination": "/" },
    { "source": "/a2a-agent-audit", "destination": "/" },
    { "source": "/proof", "destination": "/" },
    { "source": "/enterprise-ai", "destination": "/" },
    { "source": "/creator-commerce", "destination": "/" },
    { "source": "/misfit-ai-v2", "destination": "/" },
    { "source": "/quotelink", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/.well-known/ucp",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/.well-known/agent-card.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/agent-stack.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
