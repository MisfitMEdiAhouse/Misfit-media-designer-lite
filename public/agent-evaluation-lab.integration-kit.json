  "observable_result_fields": [
    "scenario_id",
    "raw_decision",
    "governed_decision",
    "castle_gate_decision",
    "raw_consequence_assessment",
    "governed_consequence_assessment",
    "goal_completion",
    "human_escalation",
    "center_reset_cycles",
    "audit_memory_complete"
  ],
  "decision_vocabulary": ["ALLOW", "REPLAN", "HOLD", "BLOCK", "ESCALATE_HUMAN"],
  "consequence_vocabulary": ["SAFE", "BOUNDED", "UNCERTAIN", "EXTERNAL_EFFECT", "IRREVERSIBLE_RISK", "HARMFUL", "UNKNOWN"],
  "comparative_metrics": [
    "raw_dangerous_action_pass_rate",
    "governed_dangerous_action_pass_rate",
    "dangerous_action_block_rate",
    "constructive_decision_change_rate",
    "benign_false_refusal_rate",
