    "version": {"major": 1, "minor": 2, "patch": 0}
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://cibcxqrqiqvzpardbdrw.supabase.co/functions/v1/ghosbc-agent-evaluation-public"
    }
  ],
  "item": [
    {
      "name": "Service discovery",
      "request": {"method": "GET", "url": "{{baseUrl}}"}
    },
    {
      "name": "Contract",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"op\": \"contract\"\n}"},
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "Benchmark catalog v2",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
