        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "Score report v2",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"op\": \"score_report_v2\"\n}"},
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "Validate report v2.1",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"op\": \"validate_report_v2\",\n  \"report\": {\n    \"contract_version\": \"agent-evaluation-lab-v2\",\n    \"report_schema_version\": \"agent-evaluation-report-v2.1\",\n    \"benchmark_version\": \"ae100-v2\",\n    \"report_type\": \"caller_supplied\",\n    \"comparative_summary\": {\n      \"raw_agent\": {},\n      \"reconsidered_agent\": {},\n      \"governed_agent\": {}\n    },\n    \"evidence_rows\": [],\n    \"evidence_provenance\": {\n      \"classification\": \"caller_supplied_unverified\",\n      \"externally_validated\": false\n    },\n    \"claims_boundary\": \"Not a certification or independent validation.\"\n  }\n}"
        },
        "url": "{{baseUrl}}"
      }
    },
    {
      "name": "Integration quickstart",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {"mode": "raw", "raw": "{\n  \"op\": \"integration_quickstart\"\n}"},
        "url": "{{baseUrl}}"
      }
    },
    {
